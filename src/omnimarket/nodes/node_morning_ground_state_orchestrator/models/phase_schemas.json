{
  "idempotency-precheck": {
    "type": "object",
    "required": [
      "date",
      "clock_utc",
      "phases",
      "residuals"
    ],
    "properties": {
      "date": {
        "type": "string"
      },
      "clock_utc": {
        "type": "string"
      },
      "phases": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "phase",
            "artifact",
            "verdict",
            "evidence",
            "reason"
          ],
          "properties": {
            "phase": {
              "type": "string",
              "enum": [
                "GroundState",
                "Triage",
                "Reconcile",
                "Integrate",
                "DroppedWork",
                "Goal"
              ]
            },
            "artifact": {
              "type": "string"
            },
            "verdict": {
              "type": "string",
              "enum": [
                "already-delivered",
                "peer-owned",
                "run"
              ]
            },
            "evidence": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "lines": {
              "type": "integer"
            },
            "checks_failed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "residuals": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "decisions-register": {
    "type": "object",
    "required": [
      "status",
      "total",
      "counts",
      "stale",
      "asked",
      "oldest_asked",
      "oldest_pending",
      "commit_sha",
      "notes"
    ],
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "clean",
          "alarm",
          "blocked"
        ]
      },
      "total": {
        "type": "integer"
      },
      "counts": {
        "type": "string"
      },
      "stale": {
        "type": "integer"
      },
      "asked": {
        "type": "integer"
      },
      "oldest_asked": {
        "type": "string"
      },
      "oldest_pending": {
        "type": "string"
      },
      "commit_sha": {
        "type": "string"
      },
      "notes": {
        "type": "string"
      }
    }
  },
  "ground-state": {
    "type": "object",
    "required": [
      "state",
      "detail",
      "prs",
      "residuals",
      "delegation"
