              }
            },
            "note": {
              "type": "string"
            }
          }
        }
      },
      "rows": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "what",
            "source",
            "kind",
            "destination",
            "next_action",
            "probe",
            "hold",
            "ticket",
            "unblocks"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "what": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "deploy",
                "repin",
                "wire",
                "release",
                "dogfood"
              ]
            },
            "destination": {
              "type": "string"
            },
            "next_action": {
              "type": "string"
            },
            "probe": {
              "type": "string"
            },
            "hold": {
              "type": "string"
            },
            "ticket": {
              "type": "string"
            },
            "ticket_created": {
              "type": "boolean"
            },
            "unblocks": {
              "type": "string"
            }
          }
        }
      },
      "counts": {
        "type": "object",
        "required": [
          "total",
          "from_landed",
          "from_window_merges",
          "held",
          "actionable"
        ],
        "properties": {
