          "type": "string"
        }
      },
      "tickets_created": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "residuals": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "delegation": {
        "type": "object",
        "required": [
          "delegated",
          "runs",
          "reason"
        ],
        "properties": {
          "delegated": {
            "type": "integer",
            "minimum": 0
          },
          "runs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        }
