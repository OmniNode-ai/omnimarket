      },
      "residuals": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "delegation": {
        "type": "object",
        "required": [
          "delegated",
          "runs",
          "reason"
        ],
        "properties": {
          "delegated": {
            "type": "integer",
            "minimum": 0
