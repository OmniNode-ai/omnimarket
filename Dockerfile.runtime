# Market depends on infra, never the reverse. The base is built at the
# release-train-moved infra tag from uv.lock, never a sha; see
# the "Resolve the infra runtime ref from uv.lock" step in
# .github/workflows/runtime-boot-composed.yml.
ARG INFRA_RUNTIME_IMAGE
FROM ${INFRA_RUNTIME_IMAGE}

RUN echo "Building the omnimarket layer on the supplied infra runtime image"

ARG OMNIMARKET_VCS_REF=unknown
USER root
COPY --chown=omniinfra:omniinfra pyproject.toml README.md /opt/omnimarket/
COPY --chown=omniinfra:omniinfra src/ /opt/omnimarket/src/
# pyproject's wheel force-include packages this lane file.
COPY --chown=omniinfra:omniinfra config/ci_bus_lanes.yaml /opt/omnimarket/config/ci_bus_lanes.yaml
# pyproject's wheel force-include packages the config/onex tree as onex_config.
COPY --chown=omniinfra:omniinfra config/onex/ /opt/omnimarket/config/onex/

# Replace market even while older infra base images still carry a copy.
RUN uv pip uninstall --python /app/.venv/bin/python omnimarket || true
RUN ( cd / && VIRTUAL_ENV=/app/.venv uv pip install --python /app/.venv/bin/python --no-deps --no-sources --no-cache --reinstall-package omnimarket "omnimarket @ file:///opt/omnimarket" )
RUN /app/.venv/bin/python -m omnibase_infra.runtime.strip_runtime_entry_points

COPY --chown=omniinfra:omniinfra src/omnimarket/configs/routing_tiers.yaml /app/config/delegation/routing_tiers.yaml
COPY --chown=omniinfra:omniinfra src/omnimarket/configs/bifrost_delegation.yaml /app/config/delegation/bifrost_delegation.base.yaml
ENV BIFROST_BASE_CONTRACT_PATH=/app/config/delegation/bifrost_delegation.base.yaml
# OMN-24052: this image is the operator runtime on lab and dev hosts. omnibase_core hides the INTERNAL command
# groups (settings, scm, ...) unless this switch is on; the customer surface list itself is unchanged.
ENV ONEX_CLI_SHOW_ALL_COMMANDS=1

RUN /app/.venv/bin/python - <<'PY'
import importlib
import importlib.metadata
import os
from pathlib import Path

import omnimarket
from omnimarket.nodes.node_llm_delegation_call_effect import HandlerLlmDelegationCall

importlib.import_module("omnimarket.nodes.node_delegate_skill_orchestrator")
assert Path(os.environ["BIFROST_BASE_CONTRACT_PATH"]).is_file()
print("omnimarket", importlib.metadata.version("omnimarket"))
PY

# OMN-21422: both GitHub nodes are registered under onex.nodes by omnimarket and
# import in this image, after the entry-point strip above.
RUN /app/.venv/bin/python - <<'GITHUB_NODES'
import importlib
import importlib.metadata

NODES = ("node_github_repo_write_effect", "node_github_repo_gateway_effect")
registered = importlib.metadata.entry_points(group="onex.nodes")
for node in NODES:
    matches = [entry for entry in registered if entry.name == node]
    assert len(matches) == 1, f"{node}: {len(matches)} onex.nodes entry points"
    entry = matches[0]
    assert entry.value == f"omnimarket.nodes.{node}", f"{node}: {entry.value}"
    dist = entry.dist.name.lower().replace("_", "-") if entry.dist else None
    assert dist == "omnimarket", f"{node}: registered by {dist}"
    importlib.import_module(entry.value)
print("github nodes registered and importable:", ",".join(NODES))
GITHUB_NODES

# OMN-26405: the prebuilt node manifest, rebuilt here as the last instruction that
# changes any stamp input. The infra image stamps its manifest before this layer
# uninstalls and reinstalls omnimarket and strips the entry points, so the stamp's
# distribution listing no longer matched the installed one and every boot read the
# file stale. The same entry point the infra image runs builds it again from what is
# installed now. The active package set and the workload come from the stamp of the
# manifest the base image carries (the infra image wrote them from the runtime
# policy); a build argument still wins. The step fails closed: no stamp, an empty set
# or a workload that is not a plain word stops the build rather than stamping an
# empty set. Nothing after this point installs, copies or strips anything.
ARG PREBUILT_ACTIVE_RUNTIME_PACKAGES=""
ARG PREBUILT_WORKLOAD=""
RUN <<'MANIFEST'
set -eu
py=/app/.venv/bin/python
stamped="$("${py}" - <<'PY'
import sys

from omnibase_infra.handlers.handler_prebuilt_manifest import prebuilt_manifest_path
from omnibase_infra.models.node_announce.model_prebuilt_node_manifest import (
    ModelPrebuiltNodeManifest,
)

path = prebuilt_manifest_path()
if not path.is_file():
    sys.exit(f"OMN-26405: the base image carries no prebuilt node manifest at {path}")
stamp = ModelPrebuiltNodeManifest.model_validate_json(path.read_bytes()).stamp
print(stamp.active_packages)
print(stamp.workload)
PY
)"
active="${PREBUILT_ACTIVE_RUNTIME_PACKAGES:-$(printf '%s\n' "${stamped}" | sed -n 1p)}"
workload="${PREBUILT_WORKLOAD:-$(printf '%s\n' "${stamped}" | sed -n 2p)}"
case "${active}" in
  ""|*[!A-Za-z0-9_.,-]*)
    echo "OMN-26405: no usable active package set for the prebuilt manifest (got '${active}'); the base image's stamp names none and PREBUILT_ACTIVE_RUNTIME_PACKAGES is unset" >&2
    exit 1;;
esac
case "${workload}" in
  ""|*[!A-Za-z0-9_.-]*)
    echo "OMN-26405: no usable workload for the prebuilt manifest (got '${workload}')" >&2
    exit 1;;
esac
ONEX_ACTIVE_RUNTIME_PACKAGES="${active}" \
  "${py}" -m omnibase_infra.nodes.node_boot_catalog_effect.runtime_prebuilt_manifest build \
    --workload "${workload}"
MANIFEST

LABEL com.omninode.omnimarket_vcs_ref=${OMNIMARKET_VCS_REF}
USER root
